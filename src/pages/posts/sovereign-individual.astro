---
// Correct-spelling alias for /posts/soreverign-individual/.
// The original slug stays put so inbound links keep working.
// This static GitHub Pages build cannot emit an HTTP 301. The page below is
// the same shape as Astro's static redirect template: instant meta-refresh,
// canonical pointed at the original URL, and noindex. Not a Cloudflare Zone rule.
const target = "/posts/soreverign-individual/";
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang="en" data-pagefind-ignore="all">
	<head>
		<meta charset="utf-8" />
		<title>Redirecting to: {target}</title>
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={canonical} />
		<meta data-pagefind-ignore="all" />
	</head>
	<body data-pagefind-ignore="all">
		<p>
			<a href={target}>Redirecting to <code>{target}</code></a>
		</p>
	</body>
</html>
